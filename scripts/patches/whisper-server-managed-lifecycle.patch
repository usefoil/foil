diff --git a/ggml/src/ggml-metal/CMakeLists.txt b/ggml/src/ggml-metal/CMakeLists.txt
index a661e710..b7e31911 100644
--- a/ggml/src/ggml-metal/CMakeLists.txt
+++ b/ggml/src/ggml-metal/CMakeLists.txt
@@ -113,6 +113,51 @@ if (GGML_METAL_EMBED_LIBRARY)
     endforeach()

     target_sources(ggml-metal PRIVATE ${METALLIB_EMBED_ASM_FILES})
+
+    option(FOIL_METAL_PRECOMPILE "Embed build-time-compiled Metal libraries" OFF)
+    if (FOIL_METAL_PRECOMPILE)
+        add_compile_definitions(FOIL_METAL_PRECOMPILE)
+        set(FOIL_METAL_SDK "${CMAKE_OSX_SYSROOT}")
+        if (NOT FOIL_METAL_SDK)
+            set(FOIL_METAL_SDK macosx)
+        endif()
+        set(FOIL_METAL_LIBRARIES "")
+        foreach(variant plain bf16)
+            set(FOIL_METAL_DEFINES "")
+            if (variant STREQUAL bf16)
+                list(APPEND FOIL_METAL_DEFINES -DGGML_METAL_HAS_BF16)
+            endif()
+            set(FOIL_METAL_AIR_FILES "")
+            foreach(src ${METALLIB_KERNEL_SOURCES})
+                get_filename_component(kind ${src} NAME_WE)
+                set(AIR "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/foil-${variant}-${kind}.air")
+                list(APPEND FOIL_METAL_AIR_FILES "${AIR}")
+                add_custom_command(
+                    OUTPUT "${AIR}"
+                    COMMAND xcrun -sdk ${FOIL_METAL_SDK} metal -O3
+                            -mmacosx-version-min=14.0 -std=metal3.1 ${FOIL_METAL_DEFINES}
+                            -I "${CMAKE_CURRENT_SOURCE_DIR}" -I "${CMAKE_CURRENT_SOURCE_DIR}/.."
+                            -c "${CMAKE_CURRENT_SOURCE_DIR}/${src}" -o "${AIR}"
+                    DEPENDS ${src} ${METALLIB_COMMON} ggml-metal-impl.h
+                            kernels/common.h kernels/dequantize.h kernels/quantize.h
+                    VERBATIM
+                )
+            endforeach()
+            set(LIB "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/foil-${variant}.metallib")
+            list(APPEND FOIL_METAL_LIBRARIES "${LIB}")
+            add_custom_command(
+                OUTPUT "${LIB}"
+                COMMAND xcrun -sdk ${FOIL_METAL_SDK} metallib ${FOIL_METAL_AIR_FILES} -o "${LIB}"
+                DEPENDS ${FOIL_METAL_AIR_FILES}
+                VERBATIM
+            )
+            set(ASM "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/foil-${variant}.s")
+            file(WRITE "${ASM}" ".section __DATA,__foil_metallib\n.globl _foil_metallib_${variant}_start\n_foil_metallib_${variant}_start:\n.incbin \"${LIB}\"\n.globl _foil_metallib_${variant}_end\n_foil_metallib_${variant}_end:\n")
+            target_sources(ggml-metal PRIVATE "${ASM}")
+        endforeach()
+        add_custom_target(foil-metal-libraries DEPENDS ${FOIL_METAL_LIBRARIES})
+        add_dependencies(ggml-metal foil-metal-libraries)
+    endif()
 else()
     # copy header files to bin directory
     configure_file(../ggml-common.h  ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/ggml-common.h     COPYONLY)
diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
index e20a4e89..fd9b3399 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -449,6 +449,32 @@ ggml_metal_library_t ggml_metal_library_init(ggml_metal_device_t dev) {
 #endif

 #if GGML_METAL_EMBED_LIBRARY
+#if FOIL_METAL_PRECOMPILE
+    // Keep the optional Metal 4 tensor path unchanged. Ordinary Metal devices
+    // load build-time-compiled, signed bytes rather than compiling 20 sources
+    // on the critical model-startup path. Separate variants preserve BF16 support.
+    if (!ggml_metal_device_get_props(dev)->has_tensor) {
+        extern const char foil_metallib_plain_start[], foil_metallib_plain_end[];
+        extern const char foil_metallib_bf16_start[], foil_metallib_bf16_end[];
+        const bool bf16 = ggml_metal_device_get_props(dev)->has_bfloat;
+        const char * start = bf16 ? foil_metallib_bf16_start : foil_metallib_plain_start;
+        const char * end = bf16 ? foil_metallib_bf16_end : foil_metallib_plain_end;
+        // The bytes belong to this signed executable and outlive the library.
+        dispatch_data_t data = dispatch_data_create(start, end - start,
+            dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{});
+        NSError * error = nil;
+        res->objs[0] = [device newLibraryWithData:data error:&error];
+        dispatch_release(data);
+        if (!res->objs[0]) {
+            GGML_LOG_ERROR("%s: failed to load embedded precompiled Metal library\n", __func__);
+            ggml_metal_library_free(res);
+            return NULL;
+        }
+        res->single_library = true;
+        GGML_LOG_INFO("%s: loaded embedded precompiled Metal library\n", __func__);
+        return res;
+    }
+#endif
     GGML_LOG_INFO("%s: using embedded metal library\n", __func__);

     // start/end symbols emitted by CMake (see CMakeLists.txt), one pair per kind
